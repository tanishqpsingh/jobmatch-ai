# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# Database Configuration (PostgreSQL)
POSTGRES_USER=jobmatch_user
POSTGRES_PASSWORD=jobmatch_password_placeholder
POSTGRES_DB=jobmatch_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://jobmatch_user:jobmatch_password_placeholder@localhost:5432/jobmatch_db

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Frontend Public API URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
