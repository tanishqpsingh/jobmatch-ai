# ==============================================================================
# JobMatch AI — Environment Variables Reference
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT: Never commit actual secret keys or API credentials to Git.
# ==============================================================================

# ==============================================================================
# 1. LOCAL DEVELOPMENT ENVIRONMENT
# ==============================================================================
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# CORS — Local frontend URL
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database — SQLite fallback is automatically used locally if Postgres is offline
DATABASE_URL=sqlite:///./jobmatch.db

# Google Gemini AI — Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# JWT Authentication
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-insecure-secret-key-change-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie Security (Local: secure=false, SameSite=lax)
COOKIE_SAMESITE=lax
# COOKIE_SECURE=false

# Frontend API URL (Used by Next.js client)
NEXT_PUBLIC_API_URL=http://localhost:8000


# ==============================================================================
# 2. RAILWAY PRODUCTION — FASTAPI BACKEND SERVICE
# ==============================================================================
# Set these variables in Railway Dashboard -> Backend Service -> Variables:
#
# ENVIRONMENT=production
# DEBUG=false
#
# DATABASE_URL=${{Postgres.DATABASE_URL}}
#   (Railway provides this variable reference automatically when linking Postgres)
#
# GEMINI_API_KEY=<your-real-gemini-api-key>
# GEMINI_MODEL=gemini-1.5-pro
#
# JWT_SECRET=<generate-a-64-char-random-string>
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7
#
# CORS_ORIGINS=https://<your-frontend-service>.up.railway.app
#
# Cookie configuration for cross-subdomain Railway deployment:
# COOKIE_SAMESITE=lax
# (If frontend and backend are hosted on separate custom domains or cross-origin:
#  set COOKIE_SAMESITE=none and ensure HTTPS is active)


# ==============================================================================
# 3. RAILWAY PRODUCTION — NEXT.JS FRONTEND SERVICE
# ==============================================================================
# Set this variable in Railway Dashboard -> Frontend Service -> Variables:
#
# NEXT_PUBLIC_API_URL=https://<your-backend-service>.up.railway.app
# NODE_ENV=production
